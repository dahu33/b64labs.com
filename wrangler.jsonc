{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b64labs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "6401",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "CONTACT_FROM": "noreply@b64labs.com",
    "CONTACT_TO": "contact@b64labs.com",
    "TURNSTILE_HOSTNAMES": "b64labs.com"
  },
  "routes": [{ "pattern": "b64labs.com", "custom_domain": true }],
  // Previews inherit nothing from production. Routes stay production-only.
  "previews": {
    "send_email": [{ "name": "EMAIL" }],
    "ratelimits": [
      {
        "name": "CONTACT_LIMIT",
        "namespace_id": "6402",
        "simple": { "limit": 5, "period": 60 }
      }
    ],
    "vars": {
      "CONTACT_FROM": "noreply@b64labs.com",
      "CONTACT_TO": "contact@b64labs.com"
    }
  }
}
